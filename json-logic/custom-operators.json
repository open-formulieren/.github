              "datetime": "2025-01-01T00:00:00+01:00"
            }
          ]
        },
        {},
        true
      ],
      [
        {
          "<=": [
            {
              "datetime": "2024-12-31T23:00:00.000Z"
            },
            {
              "datetime": "2025-01-01T00:00:00+01:00"
            }
          ]
        },
        {},
        true
      ]
    ]
  },
  {
    "name": "Date operator",
    "cases": [
      [
        {
          "date": "2013-09-13"
        },
        {},
        "2013-09-13"
      ],
      [
        {
          "+": [
            {"date": "2026-03-17"},
            {"duration": "P1M"}
          ]
        },
        {},
        "2026-04-17"
      ]
    ]
  },
  {
    "name": "Duration operator",
    "cases": [
      [
        {
          "+": [
            {
              "date": "2013-09-16"
            },
            {
              "duration": {
                "var": "delta"
              }
            }
          ]
        },
        {
          "delta": "P12Y6M"
        },
        "2026-03-16"
      ]
    ]
  },
  {
    "name": "rdelta operator",
    "cases": [
      [
        {
          "+": [
            {
              "date": "2026-01-01"
            },
            {
              "rdelta": [1]
            }
          ]
        },
        {},
        "2027-01-01"
      ],
      [
        {
          "+": [
            {
              "date": "2026-01-01"
            },
            {
              "rdelta": [0, 1]
            }
          ]
        },
        {},
        "2026-02-01"
      ],
      [
        {
          "+": [
            {
              "date": "2026-01-01"
            },
            {
              "rdelta": [0, 0, 1]
            }
          ]
        },
        {},
        "2026-01-02"
      ],
      [
        {
          "==": [
            {
              "+": [
                {
                  "datetime": "2026-01-01T12:00:00+01:00"
                },
                {
                  "rdelta": [0, 0, 0, 1]
                }
              ]
            },
            {
              "datetime": "2026-01-01T12:00:00.000Z"
            }
          ]
        },
        {},
        true
      ],
      [
        {
          "==": [
            {
              "+": [
                {
                  "datetime": "2026-01-01T12:00:00+01:00"
                },
                {
                  "rdelta": [0, 0, 0, 0, 1]
                }
              ]
            },
            {
              "datetime": "2026-01-01T11:01:00.000Z"
            }
          ]
        },
        {},
        true
      ],
      [
        {
          "==": [
            {
              "+": [
                {
                  "datetime": "2026-01-01T12:00:00+01:00"
                },
                {
                  "rdelta": [0, 0, 0, 0, 0, 1]
                }
              ]
            },
            {
              "datetime": "2026-01-01T11:00:01.000Z"
            }
          ]
        },
        {},
        true
      ]
    ]
  },
  {
    "name": "custom var defaults behaviour",
    "cases": [
      [{"var": ["a", 1]}, {"a": null}, 1],
      [{"var": ["a", 1]}, {"a": 3}, 3]
    ]
  },
  {
    "name": "custom math behaviour",
    "cases": [
      [{"+": [null, 5]}, {}, null],
      [{"-": [null, 5]}, {}, null],
      [{"*": [null, 5]}, {}, null],
      [{"/": [null, 5]}, {}, null],
      [{"%": [null, 5]}, {}, null],
      [{"min": [null, 5]}, {}, null],
      [{"max": [null, 5]}, {}, null]
    ]
  }
]
