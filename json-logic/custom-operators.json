[
  {
    "name": "Datetime operator",
    "cases": [
      [
        {
          "==": [
            {
              "datetime": "2025-01-01T00:00:00+01:00"
            },
            {
              "datetime": "2024-12-31T23:00:00Z"
            }
          ]
        },
        {},
        true
      ],
      [
        {
          "===": [
            {
              "datetime": "2025-01-01T00:00:00+01:00"
            },
            {
              "datetime": "2024-12-31T23:00:00.000Z"
            }
          ]
        },
        {},
        true
      ],
      [
        {
          ">": [
            {
              "datetime": "2024-12-31T23:00:00.000Z"
            },
            {
              "datetime": "2025-01-03T00:00:00+01:00"
            }
          ]
        },
        {},
        false
      ],
      [
        {
          "<": [
            {
              "datetime": "2024-12-31T23:00:00.000Z"
            },
            {
              "datetime": "2025-01-03T00:00:00+01:00"
            }
          ]
        },
        {},
        true
      ],
      [
        {
          ">=": [
            {
              "datetime": "2024-12-31T23:00:00.000Z"
            },
            {
              "datetime": "2025-01-01T00:00:00+01:00"
            }
          ]
        },
        {},
        true
      ],
      [
        {
          "<=": [
            {
              "datetime": "2024-12-31T23:00:00.000Z"
            },
            {
              "datetime": "2025-01-01T00:00:00+01:00"
            }
          ]
        },
        {},
        true
      ]
    ]
  },
  {
    "name": "Date operator",
    "cases": [
      [
        {
          "date": "2013-09-13"
        },
        {},
        "2013-09-13"
      ],
      [
        {
          "+": [{"date": "2026-03-17"}, {"duration": "P1M"}]
        },
        {},
        "2026-04-17"
      ],
      [
        {
          "-": [{"date": "2026-04-17"}, {"duration": "P1M"}]
        },
        {},
        "2026-03-17"
      ]
    ]
  },
  {
    "name": "Duration operator",
    "cases": [
      [
        {
          "+": [
            {
              "date": "2013-09-16"
            },
            {
              "duration": {
                "var": "delta"
              }
            }
          ]
        },
        {
          "delta": "P12Y6M"
        },
        "2026-03-16"
      ]
    ]
  },
  {
    "name": "rdelta operator",
    "cases": [
      [
        {
          "+": [
            {
              "date": "2026-01-01"
            },
            {
              "rdelta": [1]
            }
          ]
        },
        {},
        "2027-01-01"
      ],
      [
        {
          "+": [
            {
              "date": "2026-01-01"
            },
            {
              "rdelta": [0, 1]
            }
          ]
        },
        {},
        "2026-02-01"
      ],
      [
        {
          "+": [
            {
              "date": "2026-01-01"
            },
            {
              "rdelta": [0, 0, 1]
            }
          ]
        },
        {},
        "2026-01-02"
      ],
      [
        {
          "==": [
            {
              "+": [
                {
                  "datetime": "2026-01-01T12:00:00+01:00"
                },
                {
                  "rdelta": [0, 0, 0, 1]
                }
              ]
            },
            {
              "datetime": "2026-01-01T12:00:00.000Z"
            }
          ]
        },
        {},
        true
      ],
      [
        {
          "==": [
            {
              "+": [
                {
                  "datetime": "2026-01-01T12:00:00+01:00"
                },
                {
                  "rdelta": [0, 0, 0, 0, 1]
                }
              ]
            },
            {
              "datetime": "2026-01-01T11:01:00.000Z"
            }
          ]
        },
        {},
        true
      ],
      [
        {
          "==": [
            {
              "+": [
                {
                  "datetime": "2026-01-01T12:00:00+01:00"
                },
                {
                  "rdelta": [0, 0, 0, 0, 0, 1]
                }
              ]
            },
            {
              "datetime": "2026-01-01T11:00:01.000Z"
            }
          ]
        },
        {},
        true
      ]
    ]
  },
  {
    "name": "Today operator",
    "cases": [
      [
        {"+": [{"date": "2025-03-18"}, {"duration": [{"-": [{"today": []}, {"today": []}]}]}]},
        {},
        "2025-03-18"
      ]
    ]
  },
  {
    "name": "custom var defaults behaviour",
    "cases": [
      [{"var": ["a", 1]}, {"a": null}, 1],
      [{"var": ["a", 1]}, {"a": 3}, 3]
    ]
  },
  {
    "name": "substr operator",
    "cases": [
      [{ "substr": [{ "var": "a" }, 2, 3] }, { "a": "a string" }, "str"],
      [{ "substr": [{ "var": "a" }, 2, 3] }, {}, null],
      [{ "substr": [{ "var": "a" }, 2, 3] }, { "a": null }, null],
      [{ "substr": [{ "var": "a" }, 2, 3] }, { "v": "a string" }, null]
    ]
  },
  {
    "name": "custom math behaviour",
    "cases": [
      [{"+": [null, 5]}, {}, null],
      [{"-": [null, 5]}, {}, null],
      [{"*": [null, 5]}, {}, null],
      [{"/": [null, 5]}, {}, null],
      [{"%": [null, 5]}, {}, null],
      [{"min": [null, 5]}, {}, null],
      [{"max": [null, 5]}, {}, null]
    ]
  },
  {
    "name": "comparison",
    "cases": [
      [{"==": ["1", 1]}, {}, true],
      [{"==": [true, 1]}, {}, true],
      [{"==": ["1", true]}, {}, false],
      [{"!=": ["1", 1]}, {}, false],
      [{"!=": [true, 1]}, {}, false],
      [{"!=": ["1", true]}, {}, true]
    ]
  },
  {
    "name": "strict comparison",
    "cases": [
      [{"===": ["1", 1]}, {}, false],
      [{"===": ["1", true]}, {}, false],
      [{"===": [true, 1]}, {}, false],
      [{"!==": ["1", 1]}, {}, true],
      [{"!==": ["1", true]}, {}, true],
      [{"!==": [true, 1]}, {}, true]
    ]
  },
  {
    "name": "list comparison",
    "cases": [
      [{"==": [[], []]}, {}, true],
      [{"==": [{"var": "foo"}, []]}, {"foo": []}, true],
      [{"==": [{"var": "foo"}, {"var": "bar"}]}, {"foo": [], "bar": []}, true],
      [{"==": [[{"some": "data"}], [{"some": "data"}]]}, {}, true],

      [{"==": [[1], []]}, {}, false],
      [{"==": [{"var": "foo"}, []]}, {"foo": ["a"]}, false],
      [{"==": [{"var": "foo"}, {"var": "bar"}]}, {"foo": [], "bar": [{}]}, false],
      [{"==": [[{"some": "data"}], [{"some": "other data"}]]}, {}, false],

      [{"!=": [[], []]}, {}, false],
      [{"!=": [{"var": "foo"}, []]}, {"foo": []}, false],
      [{"!=": [{"var": "foo"}, {"var": "bar"}]}, {"foo": [], "bar": []}, false],
      [{"!=": [[{"some": "data"}], [{"some": "data"}]]}, {}, false],

      [{"!=": [[1], []]}, {}, true],
      [{"!=": [{"var": "foo"}, []]}, {"foo": ["a"]}, true],
      [{"!=": [{"var": "foo"}, {"var": "bar"}]}, {"foo": [], "bar": [{}]}, true],
      [{"!=": [[{"some": "data"}], [{"some": "other data"}]]}, {}, true]
    ]
  },
  {
    "name": "strict list comparison",
    "cases": [
      [{"===": [[], []]}, {}, true],
      [{"===": [{"var": "foo"}, []]}, {"foo": []}, true],
      [{"===": [{"var": "foo"}, {"var": "bar"}]}, {"foo": [], "bar": []}, true],
      [{"===": [[{"some": "data"}], [{"some": "data"}]]}, {}, true],

      [{"===": [[1], []]}, {}, false],
      [{"===": [{"var": "foo"}, []]}, {"foo": ["a"]}, false],
      [{"===": [{"var": "foo"}, {"var": "bar"}]}, {"foo": [], "bar": [{}]}, false],
      [{"===": [[{"some": "data"}], [{"some": "other data"}]]}, {}, false],

      [{"!==": [[], []]}, {}, false],
      [{"!==": [{"var": "foo"}, []]}, {"foo": []}, false],
      [{"!==": [{"var": "foo"}, {"var": "bar"}]}, {"foo": [], "bar": []}, false],
      [{"!==": [[{"some": "data"}], [{"some": "data"}]]}, {}, false],

      [{"!==": [[1], []]}, {}, true],
      [{"!==": [{"var": "foo"}, []]}, {"foo": ["a"]}, true],
      [{"!==": [{"var": "foo"}, {"var": "bar"}]}, {"foo": [], "bar": [{}]}, true],
      [{"!==": [[{"some": "data"}], [{"some": "other data"}]]}, {}, true]
    ]
  }
]
